# Local app
SCOUTFRAME_PORT=4177
SCOUTFRAME_DATA_DIR=./data
SCOUTFRAME_TRIAL_DAYS=7
SCOUTFRAME_DEV=0

# Public checkout links. Payment Links from Stripe, Lemon Squeezy, Paddle, etc. work.
SCOUTFRAME_CHECKOUT_MONTHLY_URL=
SCOUTFRAME_CHECKOUT_YEARLY_URL=
SCOUTFRAME_SUPPORT_EMAIL=support@example.com
SCOUTFRAME_MONTHLY_PRICE=12
SCOUTFRAME_YEARLY_PRICE=99
SCOUTFRAME_CURRENCY=USD

# Ed25519 public key used by the local app to verify signed licenses.
# Keep the matching private key out of distributed builds.
SCOUTFRAME_LICENSE_PUBLIC_KEY=

# Only used by scripts/issue-license.mjs on the private fulfillment machine.
SCOUTFRAME_LICENSE_PRIVATE_KEY=
